              "label": "HOME · V3",
              "note": "FINAL PROTOTYPE"
            }
          ]
        },
        {
          "id": "n39",
          "type": "kicker",
          "text": "KEY CHANGES"
        },
        {
          "id": "n40",
          "type": "bullets",
          "items": [
            {
              "id": "n41",
              "text": "Changed from card format to record player to emphasize album art"
            },
            {
              "id": "n42",
              "text": "Emphasize one song at a time to counter information overload and mindless consuming"
            },
            {
              "id": "n43",
              "text": "Changed the navbar to a pill format to reduce visual hierarchy"
            }
          ]
        },
        {
          "id": "n199",
          "type": "divider"
        },
        {
          "id": "n45",
          "type": "statement",
          "text": "The About Page: Iterations",
          "small": true
        },
        {
          "id": "n46",
          "type": "figures",
          "frame": true,
          "items": [
            {
              "id": "n47",
              "asset": "account1",
              "alt": "Account page, iteration 1",
              "label": "ACCOUNT · V1",
              "note": "ITERATION 1"
            },
            {
              "id": "n48",
              "asset": "account2",
              "alt": "Account page, iteration 2",
              "label": "ACCOUNT · V2",
              "note": "ITERATION 2"
            },
            {
              "id": "n49",
              "asset": "account3",
              "alt": "Account page, final",
              "label": "ACCOUNT · V3",
              "note": "FINAL PROTOTYPE"
            }
          ]
        },
        {
          "id": "n50",
          "type": "kicker",
          "text": "KEY CHANGES"
        },
        {
          "id": "n51",
          "type": "bullets",
          "items": [
            {
              "id": "n52",
              "text": "Changed from card format to record player to emphasize album art"
            },
            {
              "id": "n53",
              "text": "Expanded social features: option to sync contacts and share profile to make connecting with friends as frictionless as possible"
            },
            {
              "id": "n54",
              "text": "Increased visuals for previous picks to reduce the amount users have to read"
            }
          ]
        }
      ]
    },
    {
      "id": "final",
